                "call": [
                    "NoOp"
                ]
            },
            "readonly": true,
            "desc": "Return the 40-byte ring slot: 8-byte round + 32-byte seed.\nPublic read, no auth; the asserts here are input validation, not keeper-hook failure modes. Slot must be under 8 and the shelf must exist.",
            "events": [],
            "recommendations": {}
        }
